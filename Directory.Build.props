<Project>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Terminal.Core' or '$(MSBuildProjectName)' == 'Terminal.Controls'">
    <!-- Core ships inside the Controls package, so both assemblies use the
         package version for traceable consumer diagnostics. -->
    <Version>1.0.29</Version>
    <Authors>sk0ya</Authors>
    <Company>sk0ya</Company>
    <RepositoryUrl>https://github.com/sk0ya/Terminal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Terminal.Core' or '$(MSBuildProjectName)' == 'Terminal.Controls'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Not published as a standalone package; its DLL ships bundled inside
         sk0ya.Terminal.Controls. -->
    <IsPackable>false</IsPackable>
    <PackageId>sk0ya.Terminal.Core</PackageId>
    <Authors>shigekazukoya</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sk0ya/Terminal</RepositoryUrl>
    <Description>Core services — ConPTY sessions, settings, logging, and Unicode support for the Terminal project.</Description>
    <PackageTags>terminal;conpty;core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Terminal.Controls</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Terminal.App</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Terminal.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

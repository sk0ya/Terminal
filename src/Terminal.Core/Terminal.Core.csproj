<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Not published as a standalone package; its DLL ships bundled inside
         sk0ya.Terminal.Controls. -->
    <IsPackable>false</IsPackable>
    <PackageId>sk0ya.Terminal.Core</PackageId>
    <Version>1.0.9</Version>
    <Authors>shigekazukoya</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sk0ya/Terminal</RepositoryUrl>
    <Description>Core terminal engine — ConPty sessions, ANSI buffer, input encoding, and logging for the Terminal project.</Description>
    <PackageTags>terminal;conpty;wpf;core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Terminal.Controls</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Terminal.App</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Terminal.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
